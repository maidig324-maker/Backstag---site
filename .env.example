# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables).

# URL pública final do site, sem barra no final. Usada em SEO, Open Graph e sitemap.
# Production: https://www.backstag.com.br (o build de produção falha se faltar,
# se não for https, se for localhost ou .vercel.app). Prévias: opcional — sem ela,
# o site usa o endereço da própria prévia.
NEXT_PUBLIC_SITE_URL=https://www.backstag.com.br

# WhatsApp comercial no formato internacional, só dígitos: 55 + DDD + número.
# Exemplo de formato (NÃO é um número real): 5531900000000
# Enquanto estiver vazio, os botões de WhatsApp direcionam para o Direct do Instagram.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Indexação por buscadores. Deixe vazio (ou false) até aprovar o design e
# inserir os projetos reais: o site fica com noindex e robots.txt bloqueado.
NEXT_PUBLIC_SITE_INDEXING=

# ---------------------------------------------------------------------
# Leads (formulário de diagnóstico) — cadastrar SEPARADO por ambiente na
# Vercel: "Preview" = homologação, "Production" = produção.
# Nenhuma destas variáveis (exceto a NEXT_PUBLIC_) vai para o navegador.
# ---------------------------------------------------------------------

# Precisa bater com o ambiente da Vercel: Preview → homologacao | Production → producao.
# Se não bater, a API recusa os envios (evita misturar bancos).
LEADS_AMBIENTE=homologacao

# Supabase do ambiente (Project Settings → API). Use a chave SECRETA (sb_secret_…).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Segredo aleatório (mínimo 32 caracteres) para embaralhar IP e telefone no controle anti-abuso.
LEADS_HASH_SECRET=

# Cloudflare Turnstile (um widget por ambiente). A chave do site é pública.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Domínios aceitos na verificação, separados por vírgula (obrigatório em produção).
TURNSTILE_HOSTNAMES=

# Origens que podem enviar o formulário (o endereço da própria Vercel já entra automaticamente).
# Produção: https://www.seudominio.com.br,https://seudominio.com.br
LEADS_ALLOWED_ORIGINS=

# Resend: chave com permissão só de envio. Remetente só depois de verificar o domínio.
RESEND_API_KEY=
LEADS_NOTIFY_FROM="BACKSTAG <avisos@seudominio.com.br>"
# Destinatário dos avisos de novos leads.
LEADS_NOTIFY_TO=backstagsuporte@gmail.com

# Reprocessamento da fila de avisos (segredos aleatórios com 32+ caracteres).
# CRON_SECRET: usado pelo agendamento da Vercel (somente Production).
CRON_SECRET=
# LEADS_REPROCESS_SECRET: acionamento manual (workflow "Reprocessar notificações de leads").
LEADS_REPROCESS_SECRET=
